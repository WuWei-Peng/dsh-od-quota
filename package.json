{
  "name": "dsh-od-quota",
  "version": "0.1.2",
  "description": "OpenDesign 订阅额度：在设置页登录并查看 5 小时 / 7 天剩余额度，会话标题栏常驻显示",
  "type": "module",
  "license": "MIT",
  "author": "WuWei_Peng",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WuWei-Peng/dsh-od-quota.git"
  },
  "homepage": "https://github.com/WuWei-Peng/dsh-od-quota#readme",
  "bugs": {
    "url": "https://github.com/WuWei-Peng/dsh-od-quota/issues"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "opendesign",
    "quota",
    "plugin"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": ">=0.2.0-rc.1"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.5"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-api-settings-controller"
      ]
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
